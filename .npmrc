# Install every workspace from the repo root (`npm install`).
# Nested `npm install` inside app/, 0g-compute/, contracts/, or aishi-docs/ still
# resolves to this root when those folders are workspaces.
install-strategy=hoisted

# React 19 + wagmi/RainbowKit/Next peer ranges conflict when all workspaces
# share one tree. Separate per-folder installs hid this; one root install cannot.
legacy-peer-deps=true
